{
  "version": "0.2.0",
  "configurations": [
    {
      // Tauri's dev process is a Rust binary embedding the OS webview, not a
      // Node process — there's no plain "node" launch config that can attach
      // to it. Use Terminal > Run Task > "Net Pulse: Run app (Tauri dev)"
      // (or `cd tauri-app && npx tauri dev`) to run the actual app; this repo
      // intentionally has no F5 launch entry for it. If you have the
      // CodeLLDB extension installed, you can debug the compiled Rust binary
      // directly by attaching to `tauri-app/src-tauri/target/debug/netpulse.exe`
      // after `npx tauri dev` has started it.
      "name": "Net Pulse: C++ unit tests (Debug)",
      "type": "cppvsdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/Debug/netpulse_tests.exe",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    }
  ]
}
