{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Net Pulse: Launch app (Electron)",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}/electron",
      "runtimeExecutable": "${workspaceFolder}/electron/node_modules/.bin/electron",
      "windows": { "runtimeExecutable": "${workspaceFolder}/electron/node_modules/.bin/electron.cmd" },
      "args": ["."],
      "preLaunchTask": "Net Pulse: Run app",
      "outputCapture": "std"
    },
    {
      "name": "Net Pulse: C++ unit tests (Debug)",
      "type": "cppvsdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/Debug/netpulse_tests.exe",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    }
  ]
}
