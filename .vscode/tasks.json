{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Net Pulse: Install tauri-app dependencies",
      "type": "shell",
      "command": "npm install",
      "options": { "cwd": "${workspaceFolder}/tauri-app" },
      "problemMatcher": []
    },
    {
      "label": "Net Pulse: Run app (Tauri dev)",
      "type": "shell",
      "command": "npx tauri dev",
      "options": { "cwd": "${workspaceFolder}/tauri-app" },
      "dependsOn": ["Net Pulse: Install tauri-app dependencies"],
      "dependsOrder": "sequence",
      "isBackground": true,
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": {
        "pattern": { "regexp": "^never-matches$" },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Compiling|Running",
          "endsPattern": "Finished|error\\["
        }
      }
    },
    {
      "label": "Net Pulse: Build app (Tauri release installer)",
      "type": "shell",
      "command": "npx tauri build",
      "options": { "cwd": "${workspaceFolder}/tauri-app" },
      "dependsOn": ["Net Pulse: Install tauri-app dependencies"],
      "dependsOrder": "sequence",
      "problemMatcher": []
    },
    {
      "label": "Net Pulse: Run C++ unit tests only",
      "type": "shell",
      "command": "cmake --build build --config Debug --target netpulse_tests && (cd build/Debug && ./netpulse_tests || .\\netpulse_tests.exe)",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    }
  ]
}
