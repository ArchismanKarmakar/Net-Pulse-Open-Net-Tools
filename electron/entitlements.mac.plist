<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Required for Electron's JIT (V8) under the macOS hardened runtime. -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
  <key>com.apple.security.cs.allow-dyld-environment-variables</key>
  <true/>
  <!-- The native addon (napi/build/Release/*.node) is an unsigned-by-Apple
       third-party library loaded via dlopen; disable library validation so
       the hardened runtime doesn't refuse to load it. -->
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
  <!-- Raw ICMP sockets need this on macOS even when running unprivileged
       datagram mode is unavailable; harmless to declare unconditionally. -->
  <key>com.apple.security.network.client</key>
  <true/>
  <key>com.apple.security.network.server</key>
  <true/>
</dict>
</plist>
