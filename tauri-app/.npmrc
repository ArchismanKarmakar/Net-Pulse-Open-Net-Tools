# Recent npm versions (see npm/cli's allow-git/allow-remote config, added as
# a supply-chain-security default) now REFUSE to install any dependency
# specified as a raw tarball URL unless explicitly permitted — allow-remote
# defaults to "none". That's a good default in general (installing straight
# from an arbitrary URL bypasses the registry's provenance/signing checks),
# but it's exactly what package.json's `xlsx` dependency intentionally does:
# the npm-published `xlsx` package is permanently stuck on a version with
# two known high-severity vulnerabilities (SheetJS stopped publishing fixed
# releases to the npm registry after a policy dispute — see
# https://docs.sheetjs.com/docs/getting-started/installation/nodejs and
# https://github.com/advisories/GHSA-4r6h-8v6p-xvw6), and the ONLY way to
# install the actually-patched version is SheetJS's own CDN tarball URL,
# which is exactly what's pinned in package.json.
#
# This is scoped as narrowly as npm's config allows (there's no per-package
# allowlist, only a global on/off switch) — it doesn't relax anything else,
# and this project has exactly one remote-URL dependency, this one,
# deliberately.
allow-remote=all
