{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Net Pulse - Open Net Tools",
  "version": "1.1.2",
  "identifier": "com.archismankarmakar.netpulse.opennettools",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Net Pulse \u2014 Open Net Tools",
        "width": 1600,
        "height": 900,
        "minWidth": 1280,
        "minHeight": 720,
        "backgroundColor": "#0e1116",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self' 'unsafe-eval'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: asset: http://asset.localhost",
        "connect-src": "'self' ipc: http://ipc.localhost https: data:",
        "object-src": "'none'",
        "base-uri": "'self'",
        "frame-ancestors": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "appimage",
      "deb",
      "app"
      "dmg",
    ],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "publisher": "Archisman Karmakar",
    "copyright": "Copyright \u00a9 2026 Archisman Karmakar \u2014 AGPL-3.0-or-later",
    "category": "Utility",
    "windows": {
      "nsis": {
        "installerHooks": "windows/hooks.nsh"
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQ2QTY4MEY4RkIwMTc4MUEKUldRYWVBSDcrSUNtMXZlNUx3cmFoUXlwZFB0Mi9RaWlwY3dyYlJPdW9BSUFPNmFqOFZRVk92NFgK",
      "endpoints": [
        "https://github.com/ArchismanKarmakar/Net-Pulse-Open-Net-Tools/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}