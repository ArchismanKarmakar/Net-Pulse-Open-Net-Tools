<?xml version="1.0" encoding="utf-8"?>
<!--
  MSIX package manifest for Net Pulse, hand-authored against Microsoft's own
  "manually convert a desktop app to MSIX" reference
  (learn.microsoft.com/en-us/windows/msix/desktop/desktop-to-uwp-manual-conversion)
  rather than generated by a third-party tool — see docs/MSIX_DISTRIBUTION.md
  for why (Tauri does not build MSIX natively at all; only EXE/MSI).

  This is a TEMPLATE: every @@TOKEN@@ below is substituted by
  .github/workflows/msix-build.yml at build time (sed), never edited by
  hand for a real build. Placeholder values used for local/CI testing (see
  each token below) are NOT valid for a real Microsoft Store submission —
  before submitting to Partner Center, @@PACKAGE_IDENTITY_NAME@@ and
  @@PUBLISHER@@ specifically MUST be replaced with the exact values Partner
  Center assigns once this app's name is reserved there (Partner Center ->
  App identity page). Submitting with the placeholder/test values will be
  rejected at ingestion, not silently accepted with the wrong identity.

  UNVERIFIED END-TO-END: makensis/wine let the NSIS fix earlier in this
  changelog be verified by actually running the compiled installer; there
  is no Linux-runnable equivalent for makeappx.exe/AppxManifest validation
  (both are Windows-only, no cross-platform reimplementation exists), so
  this manifest has been checked for well-formedness and mirrored closely
  against Microsoft's own published example, but has NOT been run through
  a real `makeappx pack` + `Add-AppxPackage` install cycle. Flagging this
  plainly rather than presenting it as tested, same as the original
  (wrongly trusted) EnVar assumption this project already got burned by
  once — the first real CI run of msix-build.yml is the actual test.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities">

  <Identity
    Name="@@PACKAGE_IDENTITY_NAME@@"
    Version="@@VERSION_4PART@@"
    Publisher="@@PUBLISHER@@"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>@@DISPLAY_NAME@@</DisplayName>
    <PublisherDisplayName>@@PUBLISHER_DISPLAY_NAME@@</PublisherDisplayName>
    <Description>@@DESCRIPTION@@</Description>
    <Logo>Assets\Square150x150Logo.png</Logo>
  </Properties>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <!-- MinVersion is deliberately Windows 10 1809 (17763), NetPulse's own
       floor for WebView2/Tauri v2 support elsewhere in this project (see
       tauri.conf.json's windows target and ARCHITECTURE.md) — not the
       higher 1903/19041 floor some MSIX examples default to, since there's
       no reason to require a newer OS than the app itself already does. -->
  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.22621.0" />
  </Dependencies>

  <!-- runFullTrust is mandatory for any Win32/Desktop Bridge app (a Tauri
       app is a native Win32 binary, not a UWP sandboxed app) — without
       it, the packaged exe cannot run at all. This is also precisely the
       capability the tauri-windows-bundle README (see docs/MSIX_DISTRIBUTION.md's
       comparison) calls out as narrowing Store review eligibility; it is
       not optional here, only acknowledged. -->
  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
    <Capability Name="internetClient" />
  </Capabilities>

  <Applications>
    <Application Id="NetPulse" Executable="netpulse.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="@@DISPLAY_NAME@@"
        Description="@@DESCRIPTION@@"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png"
        BackgroundColor="transparent">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" />
      </uap:VisualElements>
    </Application>
  </Applications>
</Package>
